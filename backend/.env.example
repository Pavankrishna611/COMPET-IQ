APP_NAME=COMPETIQ API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# Replace YOUR_PASSWORD with your local PostgreSQL password
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/competiq

# JWT Authentication Configuration
# Generate a 32+ character random string for production
SECRET_KEY=replace_with_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Learning Material File Uploads
UPLOAD_DIR=uploads/learning_materials
MAX_UPLOAD_SIZE_MB=20
ALLOWED_DOCUMENT_TYPES=pdf,docx,pptx,txt

# AI Assessment & RAG Assistant (Optional - Operates in MOCK/RETRIEVAL_ONLY mode if not set)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# RAG & Vector Store Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=vector_store
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_MAX_CONTEXT_CHARS=12000
